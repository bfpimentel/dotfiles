{
  "mcpServers": {
    "codebase-memory-mcp": {
      "command": "/Users/bruno/.local/bin/codebase-memory-mcp"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--browser=chrome"],
      "env": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "${CHROME_EXECUTABLE}",
        "PWTEST_SOCKETS_DIR": "/tmp/pw"
      }
    },
    "nixos": {
      "command": "uvx",
      "args": ["mcp-nixos"]
    }
  }
}
